# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment variables (Never commit secret keys!)
.env

# Application Storage (Ignore files, but keep the folders)
uploads/*
!uploads/.gitkeep
output/*
!output/.gitkeep

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Backup folders generated by our patch scripts
_backup_*/